  "route_templates": [
    {
      "id": "market",
      "pattern": "/locations/{state}/{market}/",
      "type": "market_home",
      "status": "reserved",
      "required_keys": [
        "market_id",
        "state",
        "market_slug"
      ],
      "rule": "One page per real local operating team/territory. A coverage city does not automatically create an operation."
    },
    {
      "id": "coverage-city",
      "pattern": "/service-area/{city-state}/",
      "type": "coverage_city",
      "status": "reserved",
      "required_keys": [
        "market_id",
        "city",
        "state",
        "city_state_slug"
      ],
      "rule": "Create selectively for confirmed service coverage with distinct useful local material. Do not generate every city/product combination."
    },
    {
      "id": "project",
      "pattern": "/our-work/{project-slug}/",
      "type": "project",
      "status": "reserved",
      "required_keys": [
        "project_id",
        "market_id",
        "city",
        "product_ids",
        "original_photos"
      ],
      "rule": "Use actual completed Sunboy work. The stable project URL does not depend on its current operator."
    },
    {
      "id": "resource",
      "pattern": "/resources/{article-slug}/",
      "type": "resource",
      "status": "reserved",
      "required_keys": [
        "topic",
        "author",
        "reviewed_date"
      ],
      "rule": "Useful brand-level guidance; link to relevant categories/products and consultation."
    },
    {
      "id": "service-detail",
      "pattern": "/services/{service-slug}/",
      "type": "service",
      "status": "conditional",
      "required_keys": [
        "confirmed_service",
        "distinct_page_purpose"
      ],
      "rule": "Create only when the service warrants a useful separate page. Keep the booking form at /contact/."
    }
  ],
  "navigation": {
    "now": [
      "Indoor",
      "Outdoor",
      "Services",
      "About",
      "Service Area",
      "Book a Consultation"
    ],
    "next": "Convert Services, About and Service Area from dialogs to normal page links once the new page layouts/content are ready.",
    "future": "Add a location selector or Find a Location only when multiple markets are actually operating. Keep the shared product navigation."
  },
  "scaling_rules": [
    "Preserve current product URLs; do not copy the catalog into each city or market folder by default.",
    "Use stable market IDs independent of company-owned or franchise operator changes.",
    "Store local product availability, contacts, coverage, projects and review sources against market IDs.",
    "Keep brand product information centrally maintained. Future local editors can maintain their own verified local records.",
    "Use market/product context to route the existing consultation form later. No form integration or extra visible field is introduced now.",
    "Keep one primary page for each purpose. Coverage pages describe where Sunboy works; market pages describe the local operation.",
    "When multiple markets launch, review Tampa Bay-specific wording in shared product pages and the brand homepage. Preserve existing URLs and local relevance during that change."
  ],
